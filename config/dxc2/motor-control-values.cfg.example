# Merge this key into the EXISTING [motor_control] section in
# motor_control.cfg. Do not include this file directly: a second section is
# invalid.
#
# Lower values command more cutter travel after contact calibration on tested
# K2 firmware 1.1.6.1. Start at 0.2, recalibrate, and inspect a real cut. If
# necessary, reduce in 0.1 mm steps; excessive travel can damage the cutter or
# extruder body. The reference machine required 0.1 after an in-print
# change failed at 0.2; do not copy that result or its saved cut_pos_x blindly.
cut_pos_offset: 0.2
