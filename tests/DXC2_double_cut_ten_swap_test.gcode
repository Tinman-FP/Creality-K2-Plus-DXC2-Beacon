; Codex DXC2 bounded-retry qualification chip
; 10 actual T0/T1 swaps after the initial T0 load
; Reference test only: 0.4 mm nozzle, 250 C nozzle, 80 C bed
; Stay at the printer. Review temperatures and slot contents before use.
EXCLUDE_OBJECT_DEFINE NAME=DXC2_TEN_SWAP_CHIP CENTER=175,175 POLYGON=[[160,160],[190,160],[190,190],[160,190]]
;SET PRINT AREA MIN AND MAX COORDINATES TO ENABLE ADAPTIVE PROBING
; MINX = 160
; MINY = 160
; MAXX = 190
; MAXY = 190
M140 S0
M104 S0
BOX_ENABLE_CFS_PRINT ENABLE=1
START_PRINT EXTRUDER_TEMP=250 BED_TEMP=80 CFS_SLOT=T1A
CODEX_CFS_SELECT SLOT=T1A
G4 P5000
CODEX_REQUIRE_FILAMENT
T0
M109 S250
G90
G21
M83
M106 S0
M106 P2 S0
SET_PRESSURE_ADVANCE ADVANCE=0.038
SET_VELOCITY_LIMIT ACCEL=3000 ACCEL_TO_DECEL=1500 SQUARE_CORNER_VELOCITY=5

; Establish the chip with T0 before the qualification swaps.
G92 E0
G1 Z0.30 F600
G1 X160 Y160 F12000
G1 E1.0 F600
EXCLUDE_OBJECT_START NAME=DXC2_TEN_SWAP_CHIP
G1 X190 Y160 E1.87 F1800
G1 X190 Y190 E1.87
G1 X160 Y190 E1.87
G1 X160 Y160 E1.87

; LAYER 1, swap 1: T0 -> T1, outer inset
G1 E-2.0 F2400
G1 Z0.70 F600
T1
G1 X161 Y161 F12000
G1 Z0.30 F600
G1 E2.0 F1200
G1 X189 Y161 E1.75 F1800
G1 X189 Y189 E1.75
G1 X161 Y189 E1.75
G1 X161 Y161 E1.75

; LAYER 1, swap 2: T1 -> T0, infill
G1 E-2.0 F2400
G1 Z0.70 F600
T0
G1 X162 Y166 F12000
G1 Z0.30 F600
G1 E2.0 F1200
G1 X188 Y166 E1.62 F1800
G1 X188 Y173 F12000
G1 X162 Y173 E1.62 F1800
G1 X162 Y180 F12000
G1 X188 Y180 E1.62 F1800
G1 X188 Y187 F12000
G1 X162 Y187 E1.62 F1800

; LAYER 2, swap 3: T0 -> T1, outer perimeter
G1 E-2.0 F2400
G1 Z0.95 F600
T1
G1 X160 Y160 F12000
G1 Z0.55 F600
G1 E2.0 F1200
G1 X190 Y160 E1.56 F1800
G1 X190 Y190 E1.56
G1 X160 Y190 E1.56
G1 X160 Y160 E1.56

; LAYER 2, swap 4: T1 -> T0, inner perimeter
G1 E-2.0 F2400
G1 Z0.95 F600
T0
G1 X161 Y161 F12000
G1 Z0.55 F600
G1 E2.0 F1200
G1 X189 Y161 E1.46 F1800
G1 X189 Y189 E1.46
G1 X161 Y189 E1.46
G1 X161 Y161 E1.46

; LAYER 3, swap 5: T0 -> T1, outer perimeter
G1 E-2.0 F2400
G1 Z1.20 F600
T1
G1 X160 Y160 F12000
G1 Z0.80 F600
G1 E2.0 F1200
G1 X190 Y160 E1.56 F1800
G1 X190 Y190 E1.56
G1 X160 Y190 E1.56
G1 X160 Y160 E1.56

; LAYER 3, swap 6: T1 -> T0, inner perimeter
G1 E-2.0 F2400
G1 Z1.20 F600
T0
G1 X161 Y161 F12000
G1 Z0.80 F600
G1 E2.0 F1200
G1 X189 Y161 E1.46 F1800
G1 X189 Y189 E1.46
G1 X161 Y189 E1.46
G1 X161 Y161 E1.46

; LAYER 4, swap 7: T0 -> T1, outer perimeter
G1 E-2.0 F2400
G1 Z1.45 F600
T1
G1 X160 Y160 F12000
G1 Z1.05 F600
G1 E2.0 F1200
G1 X190 Y160 E1.56 F1800
G1 X190 Y190 E1.56
G1 X160 Y190 E1.56
G1 X160 Y160 E1.56

; LAYER 4, swap 8: T1 -> T0, inner perimeter
G1 E-2.0 F2400
G1 Z1.45 F600
T0
G1 X161 Y161 F12000
G1 Z1.05 F600
G1 E2.0 F1200
G1 X189 Y161 E1.46 F1800
G1 X189 Y189 E1.46
G1 X161 Y189 E1.46
G1 X161 Y161 E1.46

; LAYER 5, swap 9: T0 -> T1, outer perimeter
G1 E-2.0 F2400
G1 Z1.70 F600
T1
G1 X160 Y160 F12000
G1 Z1.30 F600
G1 E2.0 F1200
G1 X190 Y160 E1.56 F1800
G1 X190 Y190 E1.56
G1 X160 Y190 E1.56
G1 X160 Y160 E1.56

; LAYER 5, swap 10: T1 -> T0, inner perimeter
G1 E-2.0 F2400
G1 Z1.70 F600
T0
G1 X161 Y161 F12000
G1 Z1.30 F600
G1 E2.0 F1200
G1 X189 Y161 E1.46 F1800
G1 X189 Y189 E1.46
G1 X161 Y189 E1.46
G1 X161 Y161 E1.46
EXCLUDE_OBJECT_END NAME=DXC2_TEN_SWAP_CHIP
M400
END_PRINT
